# Neon Postgres — use the POOLED connection string (-pooler in hostname)
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require

# Vercel AI Gateway — generate at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# GitHub Personal Access Token (optional) — unauthenticated is 60 req/hr;
# a PAT gives 5000/hr. Only needed locally for running pnpm precache.
# Do NOT set this on Vercel — use INGEST_SECRET instead to lock the endpoint.
GITHUB_TOKEN=

# Ingest endpoint guard — set this on Vercel to any random string.
# The precache script will pass it as x-ingest-secret.
# Leave unset locally for open access.
INGEST_SECRET=
